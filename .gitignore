# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
.venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data files (keep samples and keep gitkeep, ignore large caches)
data/raw/*.parquet
data/processed/*.parquet
data/raw/large_*
data/processed/large_*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/sample_fashion_raw.csv
!data/processed/fashion_trends_engineered.csv

# Environment variables
.env
*.env

# IDE files
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
